# All integrations are server-side. Never use NEXT_PUBLIC_ for credentials.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_MODEL=openrouter/free
LLM_MAX_RETRIES=1
LLM_TIMEOUT_MS=12000
LLM_MODE=openrouter
PRODUCT_PROVIDER=channel3
CHANNEL3_API_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOUND_PAY_STATE_SECRET=
APP_URL=http://localhost:3000
MAX_AGENT_STEPS=10
MAX_PRODUCT_SEARCHES=3
MAX_PRODUCT_RESULTS=30
TOOL_TIMEOUT_MS=10000
